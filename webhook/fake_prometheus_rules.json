{
  "data": {
    "groups": [
      {
        "name": "prometheus_alerts",
        "interval": "1m",
        "rules": [
          {
            "alert": "HighCPUUsage",
            "expr": "node_cpu_usage > 80",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "platform"
            },
            "annotations": {
              "summary": "High CPU usage on {{ $labels.instance }}",
              "description": "CPU usage is above 80% for the last 5 minutes"
            }
          },
          {
            "alert": "CriticalCPUUsage",
            "expr": "node_cpu_usage > 95",
            "for": "2m",
            "labels": {
              "severity": "critical",
              "team": "platform"
            },
            "annotations": {
              "summary": "Critical CPU usage on {{ $labels.instance }}",
              "description": "CPU usage is above 95% - immediate action required"
            }
          },
          {
            "alert": "LowMemoryAvailable",
            "expr": "node_memory_free_percent < 15",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "platform"
            },
            "annotations": {
              "summary": "Low memory available on {{ $labels.instance }}",
              "description": "Less than 15% of memory available"
            }
          },
          {
            "alert": "CriticalMemoryUsage",
            "expr": "node_memory_free_percent < 5",
            "for": "1m",
            "labels": {
              "severity": "critical",
              "team": "platform"
            },
            "annotations": {
              "summary": "Critical memory usage on {{ $labels.instance }}",
              "description": "Less than 5% of memory available - OOM risk"
            }
          },
          {
            "alert": "HighDiskUsage",
            "expr": "node_disk_usage_percent > 80",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "team": "storage"
            },
            "annotations": {
              "summary": "High disk usage on {{ $labels.instance }}",
              "description": "Disk usage is above 80%"
            }
          },
          {
            "alert": "CriticalDiskUsage",
            "expr": "node_disk_usage_percent > 95",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "storage"
            },
            "annotations": {
              "summary": "Critical disk usage on {{ $labels.instance }}",
              "description": "Disk usage is above 95% - immediate cleanup required"
            }
          },
          {
            "alert": "DiskIOHigh",
            "expr": "node_disk_io_reads_total + node_disk_io_writes_total > 5000",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "storage"
            },
            "annotations": {
              "summary": "High disk I/O on {{ $labels.instance }}",
              "description": "Disk I/O operations are high"
            }
          },
          {
            "alert": "NetworkPacketLoss",
            "expr": "node_network_receive_drop_total > 100",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "network"
            },
            "annotations": {
              "summary": "Network packet loss on {{ $labels.instance }}",
              "description": "Network is experiencing packet loss"
            }
          },
          {
            "alert": "HighNetworkLatency",
            "expr": "probe_duration_seconds > 0.5",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "network"
            },
            "annotations": {
              "summary": "High network latency to {{ $labels.instance }}",
              "description": "Network latency is above 500ms"
            }
          },
          {
            "alert": "HTTPErrorRateHigh",
            "expr": "rate(http_requests_total{status=~\"5..\"}[5m]) > 0.05",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "api"
            },
            "annotations": {
              "summary": "High HTTP error rate on {{ $labels.instance }}",
              "description": "More than 5% of requests are returning 5xx errors"
            }
          },
          {
            "alert": "HTTPSlowResponse",
            "expr": "histogram_quantile(0.95, http_request_duration_seconds) > 1",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "api"
            },
            "annotations": {
              "summary": "Slow HTTP responses on {{ $labels.instance }}",
              "description": "95th percentile response time is above 1 second"
            }
          },
          {
            "alert": "DatabaseConnectionPoolExhausted",
            "expr": "pg_stat_activity_count >= 90",
            "for": "2m",
            "labels": {
              "severity": "critical",
              "team": "database"
            },
            "annotations": {
              "summary": "Database connection pool exhausted on {{ $labels.instance }}",
              "description": "Connection pool is at 90% capacity"
            }
          },
          {
            "alert": "DatabaseSlowQueries",
            "expr": "rate(pg_slow_queries_total[5m]) > 10",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "database"
            },
            "annotations": {
              "summary": "Slow queries detected on {{ $labels.instance }}",
              "description": "More than 10 slow queries per minute"
            }
          },
          {
            "alert": "DatabaseReplicationLag",
            "expr": "pg_replication_lag_seconds > 30",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "database"
            },
            "annotations": {
              "summary": "Database replication lag on {{ $labels.instance }}",
              "description": "Replication lag is above 30 seconds"
            }
          },
          {
            "alert": "CacheHitRateLow",
            "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total) < 0.8",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "team": "cache"
            },
            "annotations": {
              "summary": "Low cache hit rate on {{ $labels.instance }}",
              "description": "Cache hit rate is below 80%"
            }
          },
          {
            "alert": "RedisPersistenceFailure",
            "expr": "redis_rdb_last_save_time < time() - 3600",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "cache"
            },
            "annotations": {
              "summary": "Redis persistence failure on {{ $labels.instance }}",
              "description": "Last successful save was more than 1 hour ago"
            }
          },
          {
            "alert": "KubernetesNodeNotReady",
            "expr": "kube_node_status_condition{condition=\"Ready\",status=\"true\"} == 0",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "kubernetes"
            },
            "annotations": {
              "summary": "Kubernetes node not ready",
              "description": "Node {{ $labels.node }} is not in Ready state"
            }
          },
          {
            "alert": "KubernetesPodCrashLooping",
            "expr": "kube_pod_container_status_restarts_total > 5",
            "for": "15m",
            "labels": {
              "severity": "warning",
              "team": "kubernetes"
            },
            "annotations": {
              "summary": "Pod crash looping on {{ $labels.pod }}",
              "description": "Pod {{ $labels.pod }} has restarted more than 5 times"
            }
          },
          {
            "alert": "KubernetesPodNotHealthy",
            "expr": "min_over_time(sum by (namespace, pod) (kube_pod_status_phase{phase=~\"Failed|Unknown|Pending\"})[15m:1m]) >= 1",
            "for": "15m",
            "labels": {
              "severity": "warning",
              "team": "kubernetes"
            },
            "annotations": {
              "summary": "Pod not healthy on {{ $labels.pod }}",
              "description": "Pod {{ $labels.pod }} is in {{ $labels.phase }} state"
            }
          },
          {
            "alert": "DockerContainerExited",
            "expr": "docker_container_state_exited > 0",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "platform"
            },
            "annotations": {
              "summary": "Docker container exited unexpectedly",
              "description": "Container {{ $labels.container_name }} has exited"
            }
          },
          {
            "alert": "PrometheusHighMemoryUsage",
            "expr": "process_resident_memory_bytes > 1073741824",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "platform"
            },
            "annotations": {
              "summary": "Prometheus high memory usage",
              "description": "Prometheus is using more than 1GB of memory"
            }
          },
          {
            "alert": "PrometheusChunksToDiskSuccess",
            "expr": "increase(prometheus_tsdb_checkpoint_creations_failed_total[5m]) > 0",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "platform"
            },
            "annotations": {
              "summary": "Prometheus checkpoint creation failed",
              "description": "Failed to create checkpoint for TSDB"
            }
          },
          {
            "alert": "AlertmanagerConfigReload",
            "expr": "alertmanager_config_last_reload_successful == 0",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "platform"
            },
            "annotations": {
              "summary": "Alertmanager config reload failed",
              "description": "Failed to reload Alertmanager configuration"
            }
          },
          {
            "alert": "ZabbixServerDown",
            "expr": "up{job=\"zabbix\"} == 0",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "monitoring"
            },
            "annotations": {
              "summary": "Zabbix server is down",
              "description": "Zabbix server is not responding"
            }
          },
          {
            "alert": "ZabbixHighQueueSize",
            "expr": "zabbix_queue_size > 1000",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "team": "monitoring"
            },
            "annotations": {
              "summary": "Zabbix queue size is high",
              "description": "Zabbix processing queue has {{ $value }} items"
            }
          },
          {
            "alert": "SSLCertificateExpiringSoon",
            "expr": "probe_ssl_earliest_cert_expiry - time() < 604800",
            "for": "1h",
            "labels": {
              "severity": "warning",
              "team": "security"
            },
            "annotations": {
              "summary": "SSL certificate expiring soon",
              "description": "SSL certificate for {{ $labels.instance }} expires in {{ $value }} days"
            }
          },
          {
            "alert": "SSLCertificateExpired",
            "expr": "probe_ssl_earliest_cert_expiry - time() < 0",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "security"
            },
            "annotations": {
              "summary": "SSL certificate expired",
              "description": "SSL certificate for {{ $labels.instance }} has expired"
            }
          },
          {
            "alert": "FilesystemReadonly",
            "expr": "node_filesystem_readonly == 1",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "storage"
            },
            "annotations": {
              "summary": "Filesystem is read-only",
              "description": "Filesystem {{ $labels.device }} is in read-only mode"
            }
          },
          {
            "alert": "UnusualNetworkActivity",
            "expr": "rate(node_network_transmit_bytes_total[5m]) > 100000000",
            "for": "10m",
            "labels": {
              "severity": "warning",
              "team": "security"
            },
            "annotations": {
              "summary": "Unusual network activity detected",
              "description": "Network transmission rate is unusually high"
            }
          },
          {
            "alert": "AuthenticationFailures",
            "expr": "rate(auth_failures_total[5m]) > 100",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "security"
            },
            "annotations": {
              "summary": "High authentication failure rate",
              "description": "More than 100 authentication failures per minute"
            }
          },
          {
            "alert": "LoadAverageHigh",
            "expr": "node_load15 > (count(node_cpu_seconds_total{mode=\"idle\"}) by (instance) * 2)",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "team": "platform"
            },
            "annotations": {
              "summary": "High load average on {{ $labels.instance }}",
              "description": "Load average is above {{ $value }} times CPU count"
            }
          },
          {
            "alert": "FileDescriptorExhausted",
            "expr": "process_open_fds / process_max_fds > 0.9",
            "for": "5m",
            "labels": {
              "severity": "critical",
              "team": "platform"
            },
            "annotations": {
              "summary": "File descriptor limit nearly exhausted",
              "description": "{{ $value | humanizePercentage }} of file descriptors are in use"
            }
          }
        ]
      }
    ]
  }
}
