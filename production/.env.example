# .env.example — só necessário para SOBREPOR os defaults do config.py
# Copiar para .env e ajustar os valores que diferem do ambiente de Dev.
# cp .env.example .env

# --- Zabbix ---
# ZABBIX_API_URL=https://zabbix-prod.example.com/api_jsonrpc.php
# ZABBIX_USER=api
# ZABBIX_PASSWORD=changeme
# ZABBIX_VERIFY_SSL=false

# --- Prometheus ---
# PROMETHEUS_URL=https://prometheus-prod.example.com
# PROMETHEUS_USER=prometheus
# PROMETHEUS_PASS=changeme
# PROMETHEUS_VERIFY_SSL=false

# --- Scheduler ---
# SYNC_INTERVAL_MINUTES=5
# PUSH_INTERVAL_MINUTES=1

# --- Logging ---
# LOG_LEVEL=INFO
