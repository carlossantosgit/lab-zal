# Copiar para .env e preencher com os valores reais
# cp .env.example .env

# --- Zabbix ---
ZABBIX_API_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_USER=api
ZABBIX_PASSWORD=changeme
ZABBIX_VERIFY_SSL=false

# --- Prometheus ---
PROMETHEUS_URL=https://prometheus.example.com
PROMETHEUS_USER=prometheus
PROMETHEUS_PASS=changeme
PROMETHEUS_VERIFY_SSL=false

# --- Scheduler ---
SYNC_INTERVAL_MINUTES=5
PUSH_INTERVAL_MINUTES=1

# --- Logging ---
LOG_LEVEL=INFO
